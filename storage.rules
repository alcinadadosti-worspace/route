rules_version = '2';

// Storage guarda somente as fotos de referência do local (RF-21): qualquer
// usuário logado vê (motorista precisa em campo), qualquer logado envia —
// só imagem, até 5 MB, no caminho do cliente. Todo o resto é negado;
// os XMLs originais de NF-e (seção 13) entram depois com regra própria
// restrita a admin.
service firebase.storage {
  match /b/{bucket}/o {
    // Nome fixo: uma foto de referência por cliente, sem espaço para lixo
    // acumulando em nomes arbitrários.
    match /clientes/{clienteId}/referencia.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Comprovante de entrega (foto do ato). Nome fixo por entrega, e o registro
    // de entrega é IMUTÁVEL por regra — então a foto não pode ser trocada
    // depois: `create` sim, sobrescrever não. Comprovante que se substitui não
    // prova nada.
    match /entregas/{entregaId}/comprovante.jpg {
      allow read: if request.auth != null;
      // `resource == null` é a guarda que IMPORTA aqui, e é explícita de
      // propósito: `allow create` sozinho NÃO barra a sobrescrita (testado
      // contra o bucket real — o segundo upload no mesmo caminho passou). Um
      // comprovante que se troca depois não prova nada, então a única escrita
      // permitida é a do arquivo que ainda não existe.
      allow write: if request.auth != null
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Basemap PMTiles (seção 12, camada 3): o app baixa o mapa embarcado
    // daqui, apenas em Wi-Fi. Escrita só pelo pipeline mensal (Admin SDK,
    // que não passa por estas regras).
    match /mapas/{arquivo} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{restante=**} {
      allow read, write: if false;
    }
  }
}
