rules_version = '2';

// Security rules por papel (seções 2 e 13). Papel vem do custom claim
// aplicado pelo script criar-usuario. Toda escrita de dados de Admin Estoque é
// da API (Admin SDK, que não passa por estas regras); os apps escrevem só o
// que nasce em campo, cada escrita limitada aos seus campos: confirmações
// (rotas/pedidos/entregas), pin + dossiê do local (clientes) e o rastro
// bruto da gravação (trilhasBrutas).

service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    function papel() {
      return logado() ? request.auth.token.get('papel', '') : '';
    }
    function escritorio() {
      return papel() == 'admin' || papel() == 'operador';
    }
    // Conta com papel ATRIBUÍDO pelo criar-usuario — não basta existir no Auth.
    // Fecha o buraco do autocadastro: se o signup do Firebase estiver aberto
    // (ou for aberto por engano um dia), uma conta auto-criada nasce com papel
    // vazio e NÃO passa daqui. Isso importa porque o id de cliente vindo da
    // planilha é o código Pessoa do ERP — numérico e ENUMERÁVEL, ao contrário
    // do hash da era XML: `get` liberado a qualquer logado viraria despejo da
    // base inteira de PII por tentativa e erro.
    function papelConhecido() {
      return papel() in ['admin', 'operador', 'motorista'];
    }
    // A escrita de campo (entrega, status do pedido) tem que pertencer a uma
    // rota do próprio motorista — senão qualquer logado adultera pedido/rota
    // alheia só sabendo o id. Um get() prova posse.
    function donoDaRota(rotaId) {
      return rotaId is string
        && exists(/databases/$(database)/documents/rotas/$(rotaId))
        && get(/databases/$(database)/documents/rotas/$(rotaId)).data.motoristaId == request.auth.uid;
    }

    // Motorista lê apenas as próprias rotas; Admin Estoque lê todas.
    // Em campo (RF-18), o dono da rota atualiza o status das paradas e a
    // conclusão — nada além desses campos.
    match /rotas/{rotaId} {
      allow read: if escritorio() || (logado() && resource.data.motoristaId == request.auth.uid);
      allow update: if logado()
        && resource.data.motoristaId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['paradas', 'status', 'concluidaEm'])
        // O campo atualiza CAMPOS das paradas (status, chegouEm, avisadoEm…),
        // nunca a composição da rota: mesma contagem antes e depois. Sem isto,
        // o dono poderia acrescentar parada forjada ou sumir com uma — e toda
        // escrita legítima do app preserva o tamanho (é sempre um map sobre o
        // mesmo array).
        && request.resource.data.paradas is list
        && request.resource.data.paradas.size() == resource.data.paradas.size()
        // Só pode MUDAR o status para em_execucao/concluida — ou deixá-lo como
        // está. O "deixar como está" existe porque há escrita em `paradas` que
        // não inicia a rota: marcar que o cliente foi avisado (seção 11.8)
        // acontece com a rota ainda `publicada`, antes da primeira entrega.
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status in ['em_execucao', 'concluida']);
      allow create, delete: if false;
    }

    // Clientes: sem CPF em claro por desenho (hash + máscara); o motorista
    // precisa de nome, contato, endereço, coordenada e observações do local.
    // Em campo ele escreve duas coisas, cada uma restrita aos seus campos:
    // o pin confirmado (RF-07, com autoria dele) e o dossiê do local (RF-21).
    match /clientes/{clienteId} {
      // `get` (por id) liberado ao motorista — ele só lê os clientes das
      // paradas da rota dele; `list` (enumerar a coleção) é só Admin Estoque,
      // senão qualquer motorista baixa a base inteira de clientes (PII) e,
      // com o id = SHA-256 do CPF, recupera CPFs por força bruta.
      allow get: if papelConhecido();
      allow list: if escritorio();
      allow update: if logado() && (
        // Pin (RF-07): coordenada tem que ser lat/lng numéricos plausíveis —
        // os limites de faixa também barram NaN (toda comparação com NaN é
        // falsa). Coordenada corrompida quebraria a publicação de rotas.
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['coordenada', 'statusMapeamento', 'mapeadoPor', 'mapeadoEm'])
         && request.resource.data.statusMapeamento == 'mapeado'
         && request.resource.data.mapeadoPor == request.auth.uid
         && request.resource.data.mapeadoEm is string
         // hasOnly nas chaves de topo não impede campos aninhados: fixa a forma.
         && request.resource.data.coordenada.keys().hasOnly(['lat', 'lng'])
         && request.resource.data.coordenada.lat is number
         && request.resource.data.coordenada.lat >= -90
         && request.resource.data.coordenada.lat <= 90
         && request.resource.data.coordenada.lng is number
         && request.resource.data.coordenada.lng >= -180
         && request.resource.data.coordenada.lng <= 180)
        // Dossiê (RF-21): texto curto e o caminho da PRÓPRIA foto do cliente
        // (não um path arbitrário nem o de outro cliente).
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fotoReferenciaPath', 'observacoes'])
            && request.resource.data.observacoes is string
            && request.resource.data.observacoes.size() < 2000
            && (request.resource.data.fotoReferenciaPath == null
                || request.resource.data.fotoReferenciaPath
                     == 'clientes/' + clienteId + '/referencia.jpg'))
      );
      allow create, delete: if false;
    }

    // Rastro cru da gravação de trilha (seção 11.1): criado em campo pelo
    // autor, imutável no aparelho — quem o consome e atualiza é a API.
    match /trilhasBrutas/{trilhaBrutaId} {
      allow read: if escritorio();
      allow create: if papelConhecido()
        && request.resource.data.gravadaPor == request.auth.uid
        && request.resource.data.status == 'pendente'
        // hasOnly (não hasAll): sem campos extras injetados no doc.
        && request.resource.data.keys().hasOnly(
             ['clienteId', 'rotaId', 'pontos', 'gravadaPor', 'iniciadaEm',
              'finalizadaEm', 'status', 'processadaEm', 'motivoDescarte', 'trilhaGerada'])
        // Shape mínimo: rastro é lista com ≥2 pontos (e teto contra spam de
        // doc gigante), para um cliente que existe. (Validar cada elemento não
        // é viável em rules — o backend filtra ponto a ponto no pós-proc.)
        && request.resource.data.pontos is list
        && request.resource.data.pontos.size() >= 2
        && request.resource.data.pontos.size() <= 50000
        && request.resource.data.clienteId is string
        && exists(/databases/$(database)/documents/clientes/$(request.resource.data.clienteId));
      allow update, delete: if false;
    }

    // Pedidos guardam os valores da nota: leitura restrita ao Admin Estoque
    // (seção 13). A confirmação em campo pode escrever SÓ o status — sem
    // permissão de leitura, o motorista nunca vê o documento.
    match /pedidos/{pedidoId} {
      allow read: if escritorio();
      // Só o dono da rota do pedido, e só a partir de 'em_rota' (máquina de
      // estados): sem isso, qualquer logado que saiba o id vira o status de
      // qualquer pedido, ou reverte um já resolvido.
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['entregue', 'insucesso']
        && resource.data.status == 'em_rota'
        && donoDaRota(resource.data.rotaId);
      allow create, delete: if false;
    }

    match /usuarios/{uid} {
      allow read: if escritorio() || (logado() && request.auth.uid == uid);
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if papelConhecido();
      allow write: if false;
    }

    match /trilhas/{trilhaId} {
      // Como clientes: `get` por id ao motorista (segue a trilha ativa da
      // parada), `list` só Admin Estoque — senão vaza a coordenada do caminho de
      // acesso de todo cliente.
      allow get: if papelConhecido();
      allow list: if escritorio();
      allow write: if false;
    }

    /**
     * Posição do motorista durante a rota (seção 11.4). Doc por ROTA, e não
     * dentro dela: o app do motorista escuta a própria rota em tempo real, e
     * gravar a posição ali dispararia leitura no celular dele a cada
     * atualização.
     *
     * Escreve só o DONO da rota, e só a própria posição — sem `donoDaRota` um
     * logado qualquer publicaria a localização de outro. Ler é do Admin Estoque:
     * o motorista não acompanha o colega.
     */
    match /posicoes/{rotaId} {
      allow read: if escritorio();
      allow write: if logado()
        && donoDaRota(rotaId)
        && request.resource.data.motoristaId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['lat', 'lng', 'precisaoM', 'rumo', 'velocidadeMs', 'em', 'motoristaId'])
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        // hasOnly limita os NOMES; os valores precisam de tipo — sem isto,
        // `rumo` aceitaria um texto de megabytes no lugar de um número.
        && request.resource.data.precisaoM is number
        && (request.resource.data.rumo == null
            || request.resource.data.rumo is number)
        && (request.resource.data.velocidadeMs == null
            || request.resource.data.velocidadeMs is number)
        && request.resource.data.em is string
        && request.resource.data.em.size() < 40;
      allow delete: if false;
    }

    // Registro de entrega/insucesso (seção 7.5): criado em campo, imutável.
    // Amarrado ao autor e a uma rota do próprio motorista, com forma validada
    // — senão vira forja de auditoria (registro falso, sem atribuição).
    match /entregas/{entregaId} {
      allow read: if escritorio();
      allow create: if logado()
        && request.resource.data.keys().hasOnly(
             ['pedidoId', 'rotaId', 'clienteId', 'resultado', 'confirmadaEm',
              'posicaoConfirmacao', 'gravadaPor', 'recebidoPor', 'comprovantePath'])
        && request.resource.data.gravadaPor == request.auth.uid
        && request.resource.data.resultado in ['entregue', 'ausente', 'nao_localizado', 'recusa']
        && request.resource.data.confirmadaEm is string
        // Forma fixa no campo aninhado, como no pin do cliente: hasOnly nas
        // chaves de topo não alcança mapa interno, e sem isto a posição
        // aceitaria campos injetados junto de lat/lng.
        && (request.resource.data.posicaoConfirmacao == null
            || (request.resource.data.posicaoConfirmacao.keys().hasOnly(['lat', 'lng'])
                && request.resource.data.posicaoConfirmacao.lat is number
                && request.resource.data.posicaoConfirmacao.lat >= -90
                && request.resource.data.posicaoConfirmacao.lat <= 90
                && request.resource.data.posicaoConfirmacao.lng is number
                && request.resource.data.posicaoConfirmacao.lng >= -180
                && request.resource.data.posicaoConfirmacao.lng <= 180))
        // Comprovante (quem recebeu + foto do ato). Nome curto para caber num
        // campo digitado na porta; caminho da PRÓPRIA entrega, não um arbitrário
        // nem o de outra — senão o comprovante de uma serviria de álibi noutra.
        && (!('recebidoPor' in request.resource.data)
            || request.resource.data.recebidoPor == null
            || (request.resource.data.recebidoPor is string
                && request.resource.data.recebidoPor.size() > 0
                && request.resource.data.recebidoPor.size() < 120))
        && (!('comprovantePath' in request.resource.data)
            || request.resource.data.comprovantePath == null
            || request.resource.data.comprovantePath
                 == 'entregas/' + entregaId + '/comprovante.jpg')
        && donoDaRota(request.resource.data.rotaId);
      allow update, delete: if false;
    }
  }
}
